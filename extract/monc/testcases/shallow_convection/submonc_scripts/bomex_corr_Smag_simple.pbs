#!/bin/bash --login
#PBS -N bomex_corr_Smag_simple
#PBS -l select=8
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -P parachute
#PBS -q normal

##############################################################
#### THIS IS AN EXAMPLE SCRIPT TO DEMONSTRATE HOW TO      ####
#### SUBMIT A CHECKPOINT JOB WITH THE CONTINUATION SCRIPT ####
#### Script assumes that there are directories called     ####
#### monc_stdout/bomex_corr, checkpoint_files/bomex_corr  ####
#### and diagnostic_files/bomex_corr                      ####
#### If these do not exist, MONC will fail                ####
##############################################################

# Make sure any symbolic links are resolved to absolute path 
export PBS_O_WORKDIR=$(readlink -f $PBS_O_WORKDIR)

# Change to the directory that the job was submitted from 
cd $PBS_O_WORKDIR

export SUBMISSION_SCRIPT_NAME=testcases/shallow_convection/submonc_scripts/bomex_corr_Smag_simple.pbs
export MONC_EXEC=./build/bin/monc_driver.exe

export TESTCASE=testcases/shallow_convection/paracon/bomex_corr_Smag_simple.mcf
export STDOUT_DIR=monc_stdout/bomex_corr
export CP_DIR=checkpoint_files/bomex_corr
export RUN_NAME=bomex_corr_dump_
export NPES=np
export MAX_CONTINUATION_RUNS=100

ulimit -c unlimited

. misc/continuation.sh

run_monc
