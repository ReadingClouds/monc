<io-configuration>
	<server-configuration>
		<thread_pool number=500/>
	</server-configuration>

#include "io/io_cfg_files/paracon_level0_scalar_fields.xml"
#include "io/io_cfg_files/paracon_level0_tendency_profile_fields.xml"
#include "io/io_cfg_files/paracon_level0_profile_resolved.xml"
#include "io/io_cfg_files/paracon_subgrid_profiles.xml" 
#include "io/io_cfg_files/paracon_TKE_diagnostics.xml"
#include "io/io_cfg_files/paracon_3d_fields.xml"
#include "io/io_cfg_files/paracon_tracers_3d.xml"
#include "io/io_cfg_files/smagorinsky_3d_fields.xml"
#include "io/io_cfg_files/smagorinsky_output.xml"
#include "io/io_cfg_files/gaussiancloud_fields.xml"
#include "io/io_cfg_files/circle_a_fields.xml"


#include "io/io_cfg_files/checkpoint.xml"


<data-writing>
  <file name="{diagnostic_file1}" write_time_frequency="{diag_write_freq}" title="All diagnostic values">
    <include group="profile_resolved" time_manipulation="averaged" output_frequency="{mm}"/>
    <include group="tendency_profile_timeseries" time_manipulation="averaged" output_frequency="{mm}"/>
    <include group="scalar_timeseries" time_manipulation="instantaneous" output_frequency="{mm}"/>
    <include group="subgrid_profiles" time_manipulation="averaged" output_frequency="{mm}"/>
    <include group="tke_fields" time_manipulation="instantaneous" output_frequency="{mm}"/>
  </file>
  <file name="{diagnostic_file2}" write_time_frequency="{diag_write_freq}" title="All diagnostic values">
    <include group="3d_fields" time_manipulation="instantaneous" output_frequency="{mm1}"/>
    <include group="3d_tracers" time_manipulation="instantaneous" output_frequency="{mm1}"/>
  </file>
  <file name="{diagnostic_file3}" write_time_frequency="{diag_write_freq}" title="All diagnostic values">
    <include group="gaussiancloud_fields" time_manipulation="instantaneous" output_frequency="{mm2}"/>
    <include group="circle_a_fields" time_manipulation="instantaneous" output_frequency="{mm2}"/>
  </file>
</data-writing>

</io-configuration>

